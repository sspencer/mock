### Get a user
# Run: curl -i 'localhost:8080/user/7?delay=2s'
GET /user/:id
Content-Type: application/json
AB-RAY: 123abc456def789-LAX
X-Request-ID: request-{{$id}}

{
    "album": "Zenyatta Mondatta",
    "id": {{$id}},
    "name": "{{$name}}",
    "email": "{{$email}}",
    "delay": "{{$delay}}",
    "message": "In a Bottle"
}

### [201] Create user
# Run: curl -X POST 'localhost:8080/user?delay=2s'
POST /user
Content-Type: application/json

{
    "id": {{$integer}},
    "delay": "{{$delay}}"
}
