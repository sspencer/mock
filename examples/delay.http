@host = http://localhost:8080

### Return a user without delay
GET {{host}}/users/0
Content-Type: application/json

{
  "id": 0,
  "name": "No delay"
}

### Return a user immediately or
@delay = 0s
GET {{host}}/users/1
Content-Type: application/json

{
  "id": 1,
  "name": "{{$name}}",
  "delay": "{{delay}}"
}

### return a user after 1 second delay
@delay = 1000ms
GET {{host}}/users/1
Content-Type: application/json

{
  "id": 1,
  "name": "{{$name}}",
  "delay": "{{delay}}"
}

### Return a user after 2 second delay
@delay = 2s
GET {{host}}/users/2
Content-Type: application/json

{
  "id": "{{$uuid}}",
  "name": "Two seconds",
  "delay": "{{delay}}"
}

