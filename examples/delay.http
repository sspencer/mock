### Return a user without delay
GET /users/0
Content-Type: application/json

{
  "id": 0,
  "name": "No delay"
}

### Return a user after 1 second when ?slow is set
@delay = 1000ms
@query.slow = *
GET /users/1
Content-Type: application/json

{
  "id": 1,
  "name": "{{$name}}",
  "delay": "{{delay}}"
}

### Return a user immediately otherwise
@delay = 0s
GET /users/1
Content-Type: application/json

{
  "id": 1,
  "name": "{{$name}}",
  "delay": "{{delay}}"
}

### Return a user after 2 second delay
@delay = 2s
GET /users/2
Content-Type: application/json

{
  "id": "{{$uuid}}",
  "name": "Two seconds",
  "delay": "{{delay}}"
}

