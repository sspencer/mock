### Admin login
# The first route that matches a request answers it, so put specific routes
# before general ones.
@json.username = admin
POST /login
Content-Type: application/json

{ "role": "admin" }

### Login with a password
@json.username = *
@json.password = *
POST /login
Content-Type: application/json

{ "role": "user" }

### [400] Anything else
POST /login
Content-Type: application/json

{ "error": "username and password are required" }

### Plain-text body pattern
@body = ~.*\bping\b.*
POST /echo
Content-Type: text/plain

pong

### [202] Status variant
GET /status-variant
Content-Type: application/json

{ "accepted": true }
