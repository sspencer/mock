@host = http://localhost:8080

### Get all users
# Run: curl localhost:8080/users
GET {{host}}/users
Content-Type: application/json

[
    {
      "id": 42,
      "name": "Rusty",
      "email": "rusty@example.com"
    },
    {
      "id": 43,
      "name": "Penny",
      "email": "penny@example.com"
    }
]

### Get one user
# Run: curl localhost:8080/users/42
GET {{host}}/users/42
Content-Type: application/json

{
  "id": 42,
  "name": "Rusty",
  "email": "rusty@example.com"
}

### Create a user
# Run: curl -d '{"name":"Penny","email":"penny@example.com"}' localhost:8080/users
POST {{host}}/users
Content-Type: application/json

{
  "id": 43,
  "name": "Penny",
  "email": "penny@example.com"
}

### Generated values
# Run: curl localhost:8080/generated
GET {{host}}/generated
Content-Type: application/json

{
  "id": "{{$guid}}",
  "lucky": {{$randomInt 1 100}},
  "created": {{$timestamp}},
  "expires": {{$timestamp 1 d}},
  "updated": "{{$datetime iso8601 -2 h}}",
  "header": "{{$datetime rfc1123}}",
  "local": "{{$localDatetime iso8601}}"
}
