### List admins
# A query matcher picks this route for /users?role=admin; plain /users falls
# through to the full list below.
# Run: curl 'localhost:8080/users?role=admin'
@query.role = admin
GET /users
Content-Type: application/json

{
    "success": true,
    "results": [
        {"id": 1, "name": "Pasta Dough", "email": "pasta@dough.com", "role": "admin"}
    ]
}

### List users
# The response body comes from an external file next to this one.
# Run: curl localhost:8080/users
GET /users

< users.json

### [404] Get user 0
# An exact @path value matches before the general :id route below.
# Run: curl localhost:8080/users/0
@path.id = 0
GET /users/:id
Content-Type: application/json

{"success": false, "error": "user 0 does not exist"}

### Get a user
# Numeric ids get a generated profile; {{$id}} is the id from the path.
# Run: curl localhost:8080/users/42
@path.id = ~[0-9]+
GET /users/:id
Content-Type: application/json

{
    "success": true,
    "id": {{$id}},
    "name": "{{$name}}",
    "email": "{{$email}}",
    "role": "viewer",
    "phone": "{{$phone}}",
    "activated": {{$bool}},
    "logins": {{$integer}},
    "lastLogin": "{{$isoTimestamp}}"
}

### [400] Get a user with a bad id
# Run: curl localhost:8080/users/me
GET /users/:id
Content-Type: application/json

{"success": false, "error": "user ids are numeric, got {{$id}}"}

### Check that a user exists
# HEAD routes are declared like any other method; they send headers only.
# Without one, HEAD is answered by the matching GET route, minus its body.
# Run: curl --head localhost:8080/users/42
@path.id = ~[0-9]+
HEAD /users/:id
Content-Type: application/json

### [409] Create a user with a taken email
# Specific cases go first: the first matching route answers.
# Run: curl -d '{"name":"Pasta","email":"pasta@dough.com"}' localhost:8080/users
@json.email = pasta@dough.com
POST /users
Content-Type: application/json

{"success": false, "error": "a user with that email already exists"}

### [201] Create a user
# {{$json.*}} copies fields from the request body into the response.
# Run: curl -i -d '{"name":"Ann","email":"ann@example.test"}' localhost:8080/users
@json.email = ~[^@\s]+@[^@\s]+
@json.name = *
POST /users
Content-Type: application/json
Location: /users/6

{
    "success": true,
    "id": 6,
    "name": "{{$json.name}}",
    "email": "{{$json.email}}",
    "role": "viewer",
    "created": "{{$datetime iso8601}}"
}

### [400] Create a user without a name or valid email
# Run: curl -d '{"name":"Ann"}' localhost:8080/users
POST /users
Content-Type: application/json

{"success": false, "error": "name and a valid email are required"}

### Replace a user
# Run: curl -X PUT -d '{"name":"Ann","email":"ann@example.test"}' localhost:8080/users/6
@json.email = ~[^@\s]+@[^@\s]+
@json.name = *
PUT /users/:id
Content-Type: application/json

{
    "success": true,
    "id": {{$id}},
    "name": "{{$json.name}}",
    "email": "{{$json.email}}",
    "updated": "{{$datetime iso8601}}"
}

### [400] Replace a user with missing fields
# Run: curl -X PUT -d '{"name":"Ann"}' localhost:8080/users/6
PUT /users/:id
Content-Type: application/json

{"success": false, "error": "PUT replaces the whole user: name and a valid email are required"}

### Change a user's role
# Run: curl -X PATCH -d '{"role":"editor"}' localhost:8080/users/6
@json.role = ~admin|editor|viewer
PATCH /users/:id
Content-Type: application/json

{"success": true, "id": {{$id}}, "role": "{{$json.role}}"}

### [422] Change a user's role to an unknown role
# Run: curl -X PATCH -d '{"role":"owner"}' localhost:8080/users/6
@json.role = *
PATCH /users/:id
Content-Type: application/json

{"success": false, "error": "role must be admin, editor or viewer"}

### Rename a user
# Run: curl -X PATCH -d '{"name":"Annie"}' localhost:8080/users/6
@json.name = *
PATCH /users/:id
Content-Type: application/json

{"success": true, "id": {{$id}}, "name": "{{$json.name}}"}

### [400] Update a user with nothing to change
# Run: curl -X PATCH -d '{}' localhost:8080/users/6
PATCH /users/:id
Content-Type: application/json

{"success": false, "error": "send a name or a role to update"}

### [204] Delete a user
# Run: curl -i -X DELETE localhost:8080/users/6
DELETE /users/:id

### [202] Send a password reset email
# Run: curl -X POST localhost:8080/users/6/password-reset
POST /users/:id/password-reset
Content-Type: application/json

{"success": true, "message": "If user {{$id}} exists, a reset link is on its way."}
