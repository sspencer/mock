### Get loaves
@delay = 1s
GET /bread/
Content-Type: application/json

[
  "sourdough",
  "baguette",
  "brioche",
  "focaccia",
  "ciabatta",
  "rye Bread",
  "multigrain",
  "pita"
]

### [201] Create loaf
@delay = 2s
POST /bread/
Content-Type: application/json

{
  "id": "{{randomInt}}",
  "name": "wheat bread"
}
